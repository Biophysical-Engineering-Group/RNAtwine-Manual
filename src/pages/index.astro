---
// The manual's first page: what RNAtwine is, with a rendered hero and three features, and the
// contents. The illustrations come from the app's render mode (see components/Art.astro); until
// they exist the page reads as text alone.
import { getCollection } from 'astro:content';
import Doc from '../layouts/Doc.astro';
import Art from '../components/Art.astro';
import art from '../data/landing.json';
let base = import.meta.env.BASE_URL;
if (!base.endsWith('/')) base += '/';
const pages = (await getCollection('manual')).sort((a, b) => a.data.order - b.data.order);
const steps = pages.filter((p) => p.data.step);
const first = pages.filter((p) => p.data.order < (steps[0]?.data.order ?? 0));
const rest = pages.filter((p) => !p.data.step && p.data.order > (steps[0]?.data.order ?? 0));
const hasHero = Object.keys(art).some((k) => k.startsWith('hero-'));
const features = [
  {
    name: 'feature_relax',
    title: 'Relax a design',
    alt: 'The five-helix tile 5HT-B relaxed and colored by how far each nucleotide moved from the drawing',
    text: 'Open a pyFuRNAce design and relax it, in seconds to a minute for a single tile; each nucleotide can be colored by how far the relax moved it from the drawing.',
    href: 'getting-started/#a-first-relax-in-five-steps',
    more: 'A first relax',
  },
  {
    name: 'feature_assemble',
    title: 'Build assemblies',
    alt: 'Four copies of a ring tile joined into a ring, drawn as twine',
    text: 'Copies of a tile join through their connector loops into dimers, rings, chains, tubes and sheets, and relaxed runs can serve as the blocks of a larger assembly.',
    href: 'build/#dimer-ring-or-chain',
    more: 'Dimers, rings and chains',
  },
  {
    name: 'feature_compare',
    title: 'Compare with experiment',
    alt: 'A relaxed model drawn inside the cryo-EM density map EMD-13592',
    text: 'Compare a relaxed model with a deposited structure, nucleotide by nucleotide, or with a cryo-EM map, and relax it into the map as a starting model for the density.',
    href: 'inspect/#compare',
    more: 'Compare',
  },
];
---
<Doc title="RNAtwine manual">
  <article class="home">
    <section class:list={['hero', { 'hero-text-only': !hasHero }]}>
      <div class="hero-text">
        <p class="eyebrow">User manual</p>
        <h1>RNAtwine</h1>
        <p class="lede">
          RNAtwine relaxes three-dimensional models of RNA.
          Each nucleotide is one site of an elastic network, in which the helices bend and twist as double-stranded RNA does.
          The relax closes the kissing loops that hold the design together, and carries their strain through the helices to a minimum of the model's energy.
          A single tile relaxes in seconds to a minute, and dimers, rings, chains, tubes and sheets of many tiles in minutes to hours.
          The result can be compared with a deposited structure or a cryo-EM map, relaxed into the map, and saved as an all-atom model.
        </p>
        <p class="hero-links">
          <a class="btn primary" href={`${base}getting-started/`}>Get started</a>
          <a class="btn" href="#the-five-steps">The five steps</a>
        </p>
      </div>
      <figure class="hero-art">
        <Art name="hero" alt="The six-helix bundle 6HB-C relaxed by RNAtwine, colored along its strand" eager />
        {hasHero && (
          <figcaption>The six-helix bundle 6HB-C, a single strand of 720 nucleotides, relaxed by RNAtwine and colored along the strand from its 5′ end to its 3′ end.</figcaption>
        )}
      </figure>
    </section>

    <ul class="features">
      {features.map((f) => (
        <li>
          <Art name={f.name} alt={f.alt} />
          <h3>{f.title}</h3>
          <p>{f.text}</p>
          <a class="more" href={`${base}${f.href}`}>{f.more} →</a>
        </li>
      ))}
    </ul>

    <div class="prose">
      <p>
        This manual follows the desktop app through its five steps: opening a design, setting up what to relax, reading the result, editing lengths and exporting structures.
        The command-line tool <code>rnatwine</code> runs the same relaxes and gives the same numbers; the page <a href={`${base}command-line/`}>Command line</a> covers it by task.
      </p>
      <h2 id="start-here">Start here</h2>
      <ul class="cards">
        {first.map((p) => (
          <li><a href={`${base}${p.slug}/`}><b>{p.data.title}</b><span>{p.data.summary}</span></a></li>
        ))}
      </ul>
      <h2 id="the-five-steps">The five steps of the app</h2>
      <ol class="cards steps">
        {steps.map((p) => (
          <li><a href={`${base}${p.slug}/`}><span class="disc">{p.data.step}</span><b>{p.data.title}</b><span>{p.data.summary}</span></a></li>
        ))}
      </ol>
      <h2 id="reference">Reference</h2>
      <ul class="cards">
        {rest.map((p) => (
          <li><a href={`${base}${p.slug}/`}><b>{p.data.title}</b><span>{p.data.summary}</span></a></li>
        ))}
      </ul>
    </div>
  </article>
</Doc>
