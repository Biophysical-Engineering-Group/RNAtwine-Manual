---
// Every page: a rail of the manual's sections on the left, in the app's brushed graphite,
// the steps of the app as numbered discs joined by a thread; the page on the right.
// Under 900 px the rail becomes a drawer opened from the top bar.
import { getCollection } from 'astro:content';
import siteCss from '../styles/site.css?raw';
import siteJs from '../scripts/site.js?raw';

interface Heading { depth: number; slug: string; text: string }
interface Props { title: string; description?: string; current?: string; headings?: Heading[] }
const { title, description = 'User manual for RNAtwine, the elastic relaxation app for RNA origami designs.', current = '', headings = [] } = Astro.props;

let base = import.meta.env.BASE_URL;
if (!base.endsWith('/')) base += '/';
const css = siteCss.replaceAll('__BASE__', base);

const pages = (await getCollection('manual')).sort((a, b) => a.data.order - b.data.order);
const here = pages.find((p) => p.slug === current);
const onStep = here?.data.step ?? 0;
const sub = headings.filter((h) => h.depth === 2);
const year = new Date().getFullYear();
// Kept out of search engines until the manual is announced: build with PUBLIC_INDEX=1 to allow indexing.
const noindex = import.meta.env.PUBLIC_INDEX !== '1';
const fullTitle = current ? `${title} · RNAtwine manual` : 'RNAtwine manual';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href={`${base}img/favicon.png`} />
    <script is:inline>
      try { const t = localStorage.getItem('rnatwine-manual-theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
    <style is:inline set:html={css}></style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to the text</a>
    <header class="mbar">
      <button class="pill navbtn" type="button" aria-controls="rail" aria-expanded="false">Contents</button>
      <a class="mmark" href={base}>RNAtwine <span>manual</span></a>
      <button class="pill" type="button" data-theme-toggle>Theme</button>
    </header>
    <div class="shell">
      <nav id="rail" class="rail" aria-label="Manual sections">
        <a class="brand" href={base} aria-current={current ? undefined : 'page'}>
          <img src={`${base}img/logo-96.png`} width="48" height="48" alt="" />
          <span><b>RNAtwine</b><small>User manual</small></span>
        </a>
        <ol class="toc">
          {pages.map((p) => {
            const on = p.slug === current;
            const step = p.data.step;
            return (
              <li class:list={['toc-item', { step: !!step, on, lit: !!step && onStep > 0 && step <= onStep }]}>
                <a href={`${base}${p.slug}/`} aria-current={on ? 'page' : undefined}>
                  {step ? <span class="disc">{step}</span> : <span class="dot" />}
                  <span class="toc-title">{p.data.title}</span>
                </a>
                {on && sub.length > 0 && (
                  <ol class="subtoc">
                    {sub.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
                  </ol>
                )}
              </li>
            );
          })}
        </ol>
        <div class="rail-foot">
          <button class="pill" type="button" data-theme-toggle>Theme</button>
        </div>
      </nav>
      <div class="scrim" hidden></div>
      <main id="main" class="main">
        <slot />
        <footer class="foot">
          <span>RNAtwine user manual · © {year} Cody Geary · MIT License</span>
        </footer>
      </main>
    </div>
    <script is:inline set:html={siteJs}></script>
  </body>
</html>
